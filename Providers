-- Estado global
local Providers = {}
local PROVIDER_ORDER = {}
local PROVIDERS_SOURCE = "builtin-2.0"
local PROVIDERS_VERSION = "builtin-2.0"
local MODEL_CACHE = {}

-- Normaliza la data recibida (remota o default) al formato interno
local function normalizeProvidersData(d)
    if type(d) ~= "table" then return nil end
    local provs = d.providers or d
    if type(provs) ~= "table" then return nil end

    local out = {}
    for pid, cfg in pairs(provs) do
        if type(cfg) == "table" then
            out[pid] = {
                name = tostring(cfg.name or pid),
                kind = tostring(cfg.kind or "openai"),
                endpoint = tostring(cfg.endpoint or ""),
                models = type(cfg.models) == "table" and cfg.models or {},
                fallbacks = type(cfg.fallbacks) == "table" and cfg.fallbacks or {},
                discover = type(cfg.discover) == "table" and cfg.discover or nil,
            }
        end
    end

    local finalOrder = {}
    if type(d.order) == "table" then
        for _, pid in ipairs(d.order) do
            if out[pid] then table.insert(finalOrder, pid) end
        end
        for pid in pairs(out) do
            local found = false
            for _, p in ipairs(finalOrder) do
                if p == pid then found = true; break end
            end
            if not found then table.insert(finalOrder, pid) end
        end
    else
        for pid in pairs(out) do table.insert(finalOrder, pid) end
        table.sort(finalOrder)
    end

    return out, finalOrder, d.version or "unknown"
end

local function readProvidersCache()
    if type(readfile) ~= "function" or type(isfile) ~= "function" then return nil end
    local ok, has = pcall(isfile, PROVIDERS_CACHE_FILE)
    if not ok or not has then return nil end
    local ok2, raw = pcall(readfile, PROVIDERS_CACHE_FILE)
    if not ok2 or type(raw) ~= "string" or raw == "" then return nil end
    local ok3, d = pcall(function() return HTTP:JSONDecode(raw) end)
    return ok3 and d or nil
end

local function writeProvidersCache(data)
    if type(writefile) ~= "function" then return end
    local ok, enc = pcall(function() return HTTP:JSONEncode(data) end)
    if ok then pcall(writefile, PROVIDERS_CACHE_FILE, enc) end
end

local function fetchProvidersRemote()
    if type(game.HttpGet) ~= "function" then return nil, "sin game:HttpGet" end
    local ok, body = pcall(game.HttpGet, game, PROVIDERS_URL)
    if not ok then return nil, "HttpGet fallo: " .. tostring(body):sub(1, 120) end
    if type(body) ~= "string" or #body < 50 then return nil, "respuesta vacia" end
    local ok2, d = pcall(function() return HTTP:JSONDecode(body) end)
    if not ok2 or type(d) ~= "table" then return nil, "JSON invalido" end
    if type(d.providers) ~= "table" then return nil, "estructura no reconocida" end
    return d, nil
end

local function applyProvidersData(rawData, source)
    local provs, order, ver = normalizeProvidersData(rawData)
    if not provs or not next(provs) then return false end
    Providers = provs
    PROVIDER_ORDER = order
    PROVIDERS_SOURCE = source
    PROVIDERS_VERSION = ver or "?"
    return true
end

-- Carga inicial: remoto -> cache -> builtin
do
    local remoteData = fetchProvidersRemote()
    if remoteData and applyProvidersData(remoteData, "remoto") then
        writeProvidersCache(remoteData)
    end
    if not next(Providers) then
        local cacheData = readProvidersCache()
        if cacheData then applyProvidersData(cacheData, "cache") end
    end
    if not next(Providers) then
        applyProvidersData(DEFAULT_PROVIDERS_DATA, "builtin-2.0")
    end
end

local function reloadProviders()
    local remoteData, err = fetchProvidersRemote()
    if remoteData and applyProvidersData(remoteData, "remoto") then
        writeProvidersCache(remoteData)
        return true, "Providers remotos v" .. PROVIDERS_VERSION ..
            " (" .. #PROVIDER_ORDER .. " proveedores)"
    end
    local cacheData = readProvidersCache()
    if cacheData and applyProvidersData(cacheData, "cache") then
        return false, "Sin conexion. Usando cache local"
    end
    applyProvidersData(DEFAULT_PROVIDERS_DATA, "builtin-2.0")
    return false, "Sin conexion. Usando builtin (" .. tostring(err) .. ")"
end

